#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

ynh_app_setting_set --app=$app --key=rnsh_enable --value=false 
hostname=$(hostname)
rpc_key=$(python3 -c "import secrets; print(secrets.token_hex(32))")
ynh_app_setting_set --app=$app --key=rpc_key --value=$rpc_key

tcp_shared_instance=""
ynh_app_setting_set --app=$app --key=tcp_shared_instance --value=$tcp_shared_instance

#=================================================
# INSTALLATION
#=================================================

pushd $install_dir
    ynh_exec_as_app python3 -m venv "$install_dir/venv"
    ynh_exec_as_app "$install_dir/venv/bin/pip" install rns
    mkdir -p "$install_dir/.reticulum"
    chown "$app:$app" "$install_dir/.reticulum"
    ynh_config_add --jinja --template=config.j2 --destination="$install_dir/.reticulum/config"
popd

#=================================================
# SYSTEM CONFIGURATION
#=================================================


ynh_config_add_systemd
yunohost service add "$app" --description="Reticulum" --log="/var/log/$app/$app.log"

ynh_config_add_systemd --service="$app-rnsh" --template="rnsh.service"

ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start"

pushd $install_dir
    identity=$(ynh_exec_as_app "$install_dir/venv/bin/rnsh" -p 2>&1 | grep '^Identity' || true)
    ynh_app_setting_set --key=identity --value=$identity
    rnsh_identity=$(ynh_exec_as_app "$install_dir/venv/bin/rnsh" -p -l 2>&1 | grep '^Identity' || true)
    ynh_app_setting_set --key=rnsh_identity --value=$rnsh_identity
    rnsh_listening=$(ynh_exec_as_app "$install_dir/venv/bin/rnsh" -p -l 2>&1 | grep '^Listening on' || true)
    ynh_app_setting_set --key=rnsh_listening --value=$rnsh_listening
    ynh_exec_as_app touch "$install_dir/.rnsh/allowed_identities"
popd

if [[ "$backbone_listen_enabled" == "1" ]]; then
    yunohost firewall allow Both $port_backbone
fi
if [[ "$tcp_server_enabled" == "1" ]]; then
    yunohost firewall allow TCP $port_tcp
fi

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
